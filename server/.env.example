PINNODE_LISTEN_ADDR=:6633
PINNODE_TAILSCALE_BASE_URL=https://api.tailscale.com
PINNODE_TAILNET=example.com
PINNODE_DATABASE_PATH=data/pinnode.db
# Created automatically with owner-only permissions when missing. Back it up separately from SQLite.
PINNODE_SECRET_PATH=data/pinnode.secret
# Optional alternative for containers/secret managers: base64-encoded 32 random bytes.
# PINNODE_INSTANCE_KEY=replace-with-base64-encoded-32-random-bytes
PINNODE_CODE_TTL=5m
PINNODE_PROVISIONING_TTL=10m
PINNODE_HEARTBEAT_TTL=5m
PINNODE_ADMIN_SESSION_TTL=12h
# 16-24 leading zero bits; 18 is the balanced default.
PINNODE_POW_DIFFICULTY=18
# First admin setup is loopback-only unless this is explicitly enabled. Remote setup still requires HTTPS.
PINNODE_ALLOW_REMOTE_SETUP=false
# Only trust X-Forwarded-For from these reverse-proxy addresses or networks.
PINNODE_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
