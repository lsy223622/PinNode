[Unit]
Description=PinNode provisioning server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pinnode
Group=pinnode
WorkingDirectory=/var/lib/pinnode
EnvironmentFile=/etc/pinnode/pinnode.env
ExecStart=/usr/local/lib/pinnode/pinnode-server
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pinnode

[Install]
WantedBy=multi-user.target
